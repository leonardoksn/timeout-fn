{
    "name": "@leonardoksn/timeout-fn",
    "version": "1.0.1",
    "description": "TypeScript library for adding timeout to async functions with retry, cancellation, and metrics",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/leonardoksn/timeout-fn.git"
    },
    "publishConfig": {
        "@leonardoksn:registry": "https://npm.pkg.github.com"
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=16.0.0"
    },
    "scripts": {
        "build": "tsup",
        "test": "NODE_OPTIONS='--no-warnings' vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "prepublishOnly": "npm run typecheck && npm test && npm run build"
    },
    "keywords": [
        "timeout",
        "promise",
        "async",
        "retry",
        "abort",
        "cancellation",
        "metrics",
        "typescript"
    ],
    "author": "Leonardo Ksn <leodev.ksn@gmail.com>",
    "license": "MIT",
    "devDependencies": {
        "@types/node": "^20.11.0",
        "tsup": "^8.0.1",
        "tsx": "^4.21.0",
        "typescript": "^5.3.3",
        "vitest": "^1.2.0"
    }
}